{
  "name": "cvarkivet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",

    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",

    "sqlite:schema": "node scripts/make-sqlite-schema.mjs",
    "sqlite:setup": "npm run sqlite:schema && prisma generate --schema=prisma/schema.local.prisma && prisma db push --schema=prisma/schema.local.prisma --accept-data-loss && npm run sqlite:seed",
    "sqlite:seed": "cross-env DATABASE_PROVIDER=sqlite DATABASE_URL=file:./dev.db tsx prisma/seed.ts",
    "dev:sqlite": "cross-env DATABASE_PROVIDER=sqlite DATABASE_URL=file:./dev.db next dev"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
