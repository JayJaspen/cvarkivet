# ---------------------------------------------------------------- Databas
# PostgreSQL-anslutning från Neon. Kopiera "Pooled connection" och lägg till
# ?sslmode=require om den saknas.
DATABASE_URL="postgresql://användare:lösenord@ep-xxx.eu-central-1.aws.neon.tech/cvarkivet?sslmode=require"

# Sätts automatiskt av npm run dev:sqlite. Rör inte i produktion.
# DATABASE_PROVIDER="sqlite"

# ------------------------------------------------------------------ Säkerhet
# Nyckel som signerar inloggningscookien. MÅSTE vara unik och hemlig.
# Generera ny med:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ---------------------------------------------------------------- Webbadress
# Används i länkar i utgående mail.
NEXT_PUBLIC_APP_URL="https://cvarkivet.se"

# ------------------------------------------------------------------- E-post
# Från resend.com. Utan nyckel loggas mail till konsolen i stället för att skickas.
RESEND_API_KEY=""
EMAIL_FROM="CVArkivet <no-reply@cvarkivet.se>"

# ------------------------------------------------------------------- Cron
# Skyddar det nattliga gallringsjobbet. Vercel skickar automatiskt med denna
# som Bearer-token. Generera med samma kommando som AUTH_SECRET.
CRON_SECRET=""

# --------------------------------------------------------------- Fillagring
# Vercel Blob för företagslogotyper. Utan token sparas filer i public/uploads/
# vilket bara fungerar vid lokal utveckling.
BLOB_READ_WRITE_TOKEN=""
